# Supabase Cloud Backend Credentials
# Copy this file to .env and fill in your Supabase project URL and Anon Key.
# When omitted, Aimprove automatically runs using the local persisted fallback store.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

